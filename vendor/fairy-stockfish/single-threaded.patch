diff --git a/src/wasi.cpp b/src/wasi.cpp
new file mode 100644
index 00000000..d398eb8c
--- /dev/null
+++ b/src/wasi.cpp
@@ -0,0 +1,63 @@
+/*
+  Fairy-Stockfish as a WebAssembly reactor (WASI), for a web page's worker: no main(), no threads, no files.
+  The worker writes a command into uci_buffer() and calls uci_command(length); the engine answers on stdout, which
+  the worker's WASI shim passes back line by line. A "go" runs its whole search before uci_command() returns.
+
+  Fairy-Stockfish is free software: you can redistribute it and/or modify it under the terms of the GNU General
+  Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option)
+  any later version.
+*/
+
+#include <iostream>
+#include <string>
+
+#include "bitboard.h"
+#include "endgame.h"
+#include "evaluate.h"
+#include "misc.h"
+#include "piece.h"
+#include "position.h"
+#include "psqt.h"
+#include "search.h"
+#include "thread.h"
+#include "tune.h"
+#include "uci.h"
+#include "variant.h"
+
+using namespace Stockfish;
+
+static char buffer[1 << 16];
+
+extern "C" {
+
+__attribute__((export_name("uci_buffer"))) char* uci_buffer() { return buffer; }
+
+__attribute__((export_name("uci_size"))) int uci_size() { return int(sizeof(buffer)); }
+
+__attribute__((export_name("uci_init"))) void uci_init() {
+
+  char name[] = "fairy-stockfish";
+  char* argv[] = { name, nullptr };
+  std::cout << engine_info() << std::endl;
+  pieceMap.init();
+  variants.init();
+  CommandLine::init(1, argv);
+  UCI::init(Options);
+  Tune::init();
+  PSQT::init(variants.find(Options["UCI_Variant"])->second);
+  Bitboards::init();
+  Position::init();
+  Bitbases::init();
+  Endgames::init();
+  Threads.set(size_t(Options["Threads"]));
+  Search::clear();
+  Eval::NNUE::init();
+}
+
+__attribute__((export_name("uci_command"))) void uci_command(int length) {
+
+  UCI::command(std::string(buffer, buffer + length));
+  std::cout.flush();
+}
+
+}
