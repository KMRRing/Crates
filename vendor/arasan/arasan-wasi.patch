diff --git a/src/wasm.cpp b/src/wasm.cpp
new file mode 100644
index 0000000..e776faa
--- /dev/null
+++ b/src/wasm.cpp
@@ -0,0 +1,85 @@
+// Arasan as a WebAssembly reactor for a page's worker (vendor/arasan/NOTE.txt), in place of arasanx.cpp's main():
+// the page writes a UCI command into uci_buffer() and calls uci_command(length); the engine answers on stdout, which
+// the worker's WASI shim hands back line by line. A "go" runs its whole search before uci_command() returns, so it
+// needs a limit. The network is not read from a file: the worker asks for room (net_alloc), unpacks the .nnue file's
+// bytes into it and calls net_ready, which reads it and gives the room back.
+#include "types.h"
+#include "attacks.h"
+#include "bitutil.h"
+#include "board.h"
+#include "globals.h"
+#include "options.h"
+#include "protocol.h"
+#include "search.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <istream>
+#include <streambuf>
+#include <string>
+
+#ifndef NETWORK_BYTES
+#error NETWORK_BYTES: the size of the .nnue file
+#endif
+
+static char s_buffer[4096];
+static Board *s_board = nullptr;
+static Protocol *s_protocol = nullptr;
+static char *s_net = nullptr;
+
+namespace {
+// an input stream over bytes that are already in memory
+struct MemoryBuf : std::streambuf {
+    MemoryBuf(char *begin, size_t size) { setg(begin, begin, begin + size); }
+};
+} // namespace
+
+extern "C" {
+
+__attribute__((export_name("uci_buffer"))) char *uci_buffer() { return s_buffer; }
+__attribute__((export_name("uci_size"))) int uci_size() { return int(sizeof(s_buffer)) - 1; }
+
+__attribute__((export_name("uci_init"))) void uci_init() {
+    setenv("HOME", "/", 1);   // (options and the learning file look for it)
+    setbuf(stdout, nullptr);
+    std::cout.rdbuf()->pubsetbuf(nullptr, 0);
+    BitUtils::init();
+    Board::init();
+    globals::initOptions(false, nullptr, false, true);
+    Attacks::init();
+    Search::init();
+    globals::initGlobals();
+    s_board = new Board();
+    // (cpusSet: the Threads option is ignored, the search always runs on the caller's own thread)
+    s_protocol = new Protocol(*s_board, false, false, true, false);
+}
+
+__attribute__((export_name("uci_command"))) void uci_command(int length) {
+    if (!s_protocol || length < 0 || length >= int(sizeof(s_buffer))) return;
+    s_buffer[length] = 0;
+    s_protocol->runCommand(std::string(s_buffer, size_t(length)));
+}
+
+__attribute__((export_name("net_size"))) int net_size() { return NETWORK_BYTES; }
+
+// room for the network file's bytes, to be filled by the page
+__attribute__((export_name("net_alloc"))) void *net_alloc() {
+    if (!s_net) s_net = static_cast<char *>(std::malloc(NETWORK_BYTES));
+    return s_net;
+}
+
+// 1 if what was copied into net_alloc()'s room is a network of this engine's format, and now the engine's
+__attribute__((export_name("net_ready"))) int net_ready() {
+    if (!s_net) return 0;
+    MemoryBuf buf(s_net, NETWORK_BYTES);
+    std::istream in(&buf);
+    in >> globals::network;
+    const bool ok = !in.fail();
+    std::free(s_net);
+    s_net = nullptr;
+    globals::nnueInitDone = ok;
+    return ok ? 1 : 0;
+}
+
+} // extern "C"
