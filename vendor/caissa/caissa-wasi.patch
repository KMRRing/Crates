+#if defined(__wasi__)
+
+// Caissa as a WebAssembly reactor (WASI), for a web page's worker: no main(), no threads, no files. The worker writes
+// a command into uci_buffer() and calls uci_command(length); the engine answers on stdout, which the worker's WASI
+// shim hands back line by line. A "go" runs its whole search before uci_command() returns, so it needs a limit.
+// The network is not read from a file: the worker asks for room (net_alloc), copies the .pnn's bytes into it and
+// calls net_ready, so the 76 MB are held once.
+#include "../backend/PackedNeuralNetwork.hpp"
+
+static char s_buffer[1 << 16];
+static UniversalChessInterface* s_uci = nullptr;
+static nn::PackedNeuralNetwork* s_pendingNet = nullptr;
+
+extern "C" {
+
+__attribute__((export_name("uci_buffer"))) char* uci_buffer() { return s_buffer; }
+
+__attribute__((export_name("uci_size"))) int uci_size() { return int(sizeof(s_buffer) - 1); }
+
+__attribute__((export_name("uci_init"))) void uci_init()
+{
+    printf("%s by %s\n", c_EngineName, c_Author);
+    InitEngine();
+    s_uci = new UniversalChessInterface();
+    fflush(stdout);
+}
+
+__attribute__((export_name("uci_command"))) void uci_command(int length)
+{
+    s_buffer[length] = 0;
+    s_uci->ExecuteCommand(s_buffer);
+    fflush(stdout);
+}
+
+/** Room for a network (a .pnn file's bytes, nn_size() of them); null if it can't be had. */
+__attribute__((export_name("net_size"))) int net_size() { return int(sizeof(nn::PackedNeuralNetwork)); }
+
+__attribute__((export_name("net_alloc"))) void* net_alloc()
+{
+    delete s_pendingNet;
+    s_pendingNet = new nn::PackedNeuralNetwork();
+    return s_pendingNet;
+}
+
+/** 1 if what was copied into net_alloc()'s room is a network of this engine's format, and now the engine's. */
+__attribute__((export_name("net_ready"))) int net_ready()
+{
+    if (!s_pendingNet || s_pendingNet->header.magic != nn::MagicNumber || s_pendingNet->header.version != nn::CurrentVersion)
+        return 0;
+    g_mainNeuralNetwork = s_pendingNet;
+    s_pendingNet = nullptr;
+    return 1;
+}
+
+}
+
+#else
+
 int main(int argc, const char* argv[])
 {
     printf("%s by %s\n", c_EngineName, c_Author);
@@ -1680,3 +1747,5 @@
 
